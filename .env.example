# Base URL for the backend API.
# In development leave this as the default: Vite proxies /api to the Go backend
# (see the `server.proxy` block in vite.config.js), so requests are same-origin.
# For production, set this to the deployed API origin, e.g. https://api.trimobe.mg/api/v1
VITE_API_URL=/api/v1
